# Upstage Solar — [0] 고민 파싱, [5] 메타인지 리포트
UPSTAGE_API_KEY=
UPSTAGE_BASE_URL=https://api.upstage.ai/v1
UPSTAGE_MODEL=solar-pro2

# STT — 브라우저 Web Speech 대신 서버에서 인식한다 (OPEN_QUESTIONS Q7)
# 첫 실행 때 모델을 내려받는다: tiny ~75MB / base ~145MB / small ~480MB
STT_ENABLED=true
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# 서버
CORS_ORIGINS=http://localhost:5173
DB_PATH=./intuition.db
